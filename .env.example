ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://sms_user:sms_password@localhost:5432/sms_gateway

CORS_ORIGINS=["*"]
RATE_LIMIT_PER_MINUTE=300

RABBITMQ_URL=amqp://guest:guest@localhost/
RABBITMQ_SMS_QUEUE=sms_send_queue
SMS_SEND_INTERVAL_MS=1000

RABBITMQ_DLR_QUEUE=dlr_forward_queue
DLR_FORWARD_MAX_RETRIES=3
DLR_FORWARD_RETRY_BACKOFF_SECONDS=2.0

# GATEWAY_PROVIDER=local -> aucun SMS réel envoyé (utile en dev)
# GATEWAY_PROVIDER=jasmin -> envoi réel via une instance Jasmin
GATEWAY_PROVIDER=local
JASMIN_BASE_URL=http://localhost:8990
JASMIN_USERNAME=
JASMIN_PASSWORD=
